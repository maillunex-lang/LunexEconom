{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikagro.ru/lunexeconom/v2/schema/content-manifest.json",
  "title": "LunexEconom content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "packs"],
  "properties": {
    "schema": {"const": 1},
    "release": {"type": "integer", "minimum": 1, "maximum": 2000000000},
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/pack"}
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "kind", "version", "size", "sha256", "url",
        "priority", "dependencies", "min_version_code", "label"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$"},
        "kind": {
          "enum": [
            "icons_goods", "icons_buildings", "ui_theme",
            "map_tiles", "season", "sounds"
          ]
        },
        "version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "url": {"type": "string", "minLength": 12, "maxLength": 300},
        "priority": {"enum": ["required", "background"]},
        "dependencies": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$"}
        },
        "min_version_code": {"type": "integer", "minimum": 1, "maximum": 2000000000},
        "label": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    }
  }
}
