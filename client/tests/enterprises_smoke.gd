extends SceneTree
const Adapter = preload("res://world/api.gd")
const Catalog = preload("res://enterprises/catalog.gd")
const Service = preload("res://enterprises/api.gd")
const Mock = preload("res://tests/enterprises_mock.gd")
func _initialize() -> void:
    call_deferred("_run")
func _run() -> void:
    var mock := Mock.new()
    root.add_child(mock)
    var adapter := Adapter.new()
    root.add_child(adapter)
    adapter.mock = Callable(mock,"respond")
    var catalog := Catalog.new()
    root.add_child(catalog)
    catalog.configure(adapter)
    assert(await catalog.update())
    assert(catalog.building("field").get("name") == "Поле")
    assert(catalog.eligible(catalog.building("field"),"free",6,6))
    assert(not catalog.eligible(catalog.building("field"),"industrial",6,6))
    assert(not catalog.eligible(catalog.building("field"),"free",1,1))
    assert(await catalog.update())
    assert(mock.calls[1].headers.has('If-None-Match: "test"'))
    var service := Service.new()
    root.add_child(service)
    service.configure(adapter)
    var first: Dictionary = await service.create("field",1,2,6,12)
    assert(first.get("code") == 201)
    var request_id := str(mock.calls.back().payload.get("request_id",""))
    service.pending["field:1:2:6:12"] = {"request_id":request_id,"building_id":"field","px":1,"py":2,"x":6,"y":12}
    service._persist()
    var retry: Dictionary = await service.create("field",1,2,6,12)
    assert(retry.get("code") == 201)
    assert(mock.calls.back().payload.get("request_id") == request_id)
    assert(mock.ids.size() == 1)
    assert((await service.list_own()).data.enterprises.size() == 1)
    assert((await service.detail(1)).data.stage_index == 4)
    assert((await service.report(1)).data.reports.size() == 1)
    assert((await service.settings(1,{"running":false})).code == 200)
    assert((await service.sell(1)).code == 200)
    assert((await service.list_own()).data.enterprises.is_empty())
    print("enterprise smoke OK: catalog etag zone footprint create retry list detail report settings sale")
    quit(0)
