extends SceneTree
const Safe = preload("res://ui/safe_area.gd")
const Forest = preload("res://theme/forest_glass.gd")
const Buttons = preload("res://ui/ui_button.gd")
const Card = preload("res://ui/ui_card.gd")
const InputField = preload("res://ui/ui_input.gd")
const Empty = preload("res://ui/ui_empty_list.gd")
const Toast = preload("res://ui/ui_toast.gd")
const Loading = preload("res://ui/ui_loading.gd")
const Confirm = preload("res://ui/ui_confirm.gd")
const Split = preload("res://ui/ui_two_columns.gd")
const Text = preload("res://ui/ui_text.gd")
func _initialize() -> void:
    call_deferred("_run")
func _run() -> void:
    var host := Control.new()
    host.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    root.add_child(host)
    var button := Buttons.new()
    host.add_child(button)
    await process_frame
    for variant in ["primary","secondary","danger"]:
        button.variant = variant
        assert(button.get_theme_stylebox("normal") != null)
        assert(button.get_combined_minimum_size().y >= 48)
    var card := Card.new()
    host.add_child(card)
    card.resize_for(2400)
    assert(card.custom_minimum_size.x <= 720)
    var field := InputField.new()
    host.add_child(field)
    field.configure("auth.login.name","auth.login.name")
    field.set_error("auth.login.error.invalid")
    assert(field.error.visible)
    field.set_error()
    assert(not field.error.visible)
    var empty := Empty.new()
    host.add_child(empty)
    assert(empty.action.text.length() > 0)
    var loading := Loading.new()
    host.add_child(loading)
    loading.set_failed()
    assert(loading.retry.visible)
    loading.set_busy()
    assert(not loading.retry.visible)
    var toast := Toast.new()
    host.add_child(toast)
    toast.show_message("ui.empty.title",60)
    assert(toast.visible and toast._timer.wait_time>=3.0 and toast._timer.wait_time<=4.0)
    assert(toast.offset_bottom <= -60)
    var dialog := Confirm.new()
    host.add_child(dialog)
    assert(dialog.exclusive)
    var text := Text.new()
    host.add_child(text)
    assert(text.max_lines_visible==3)
    var columns := Split.new()
    columns.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    host.add_child(columns)
    await process_frame
    columns.refresh_width(1280)
    assert(columns.list_host.visible and not columns.details_host.visible)
    columns.show_details(true)
    assert(columns.details_host.visible and not columns.list_host.visible)
    columns.refresh_width(1600)
    assert(columns.list_host.visible and columns.details_host.visible)
    var cutout := Safe.margins(Vector2(1280,720),Vector2i(2400,1080),Rect2i(110,0,2180,1080))
    assert(cutout.left>=60 and cutout.right>=60)
    var shell := MarginContainer.new()
    host.add_child(shell)
    Safe.apply(shell,Vector2(1280,720))
    assert(shell.get_theme_constant("margin_left")>=12)
    assert(Forest.touch_size(Vector2(2560,1080))>=48)
    print("ui1 components OK: variants, input, empty, toast, dialog, split, cutout")
    quit(0)
