extends SceneTree
func _initialize() -> void:
    var road_script = load("res://road_network.gd")
    var topology = load("res://road_topology.gd")
    var planner = load("res://construction_planner.gd").new()
    var roads = road_script.new()
    assert(topology.shape(topology.mask_at(roads, Vector2i(0, 0))) == "cross")
    assert(topology.shape(topology.mask_at(roads, Vector2i(0, 1))) == "straight")
    assert(topology.affected_cells(Vector2i(11, 11)).size() == 5)
    var world = load("res://world.gd").new()
    var valid = planner.preview(Vector2i(1, 1), Vector2i(2, 2), roads, world)
    assert(not valid.ok and valid.reason == "no_road_access")
    var near_road = planner.preview(Vector2i(1, 2), Vector2i(2, 2), roads, world)
    assert(not near_road.ok and near_road.reason == "no_road_access")
    var buildable = planner.preview(Vector2i(1, 1), Vector2i(2, 2), roads, world)
    assert(not buildable.ok)
    var access = planner.preview(Vector2i(1, 1), Vector2i(1, 1), roads, world)
    assert(not access.ok)
    assert(planner.footprint(Vector2i(4, 4), Vector2i(2, 3)).size() == 6)
    assert(planner.footprint(Vector2i.ZERO, Vector2i(0, 2)).is_empty())
    assert(planner.reserve_preview([Vector2i(4, 4)], "test"))
    assert(not planner.reserve_preview([Vector2i(4, 4)], "other"))
    planner.clear_preview("test")
    assert(not planner.occupied.has(Vector2i(4, 4)))
    print("WORLD_027_TEST_PASS topology/footprint/road-access/preview-reservation")
    world.free()
    quit()
