extends SceneTree
const UI = preload("res://ui/components.gd")
const Two = preload("res://ui/two_columns.gd")
const Safe = preload("res://ui/safe_area.gd")
const Forest = preload("res://theme/forest_glass.gd")
func _initialize() -> void:
    call_deferred("_run")
func _run() -> void:
    var kinds := ["primary", "secondary", "danger"]
    for kind in kinds:
        var btn: Button = UI.button("ui.back",kind)
        root.add_child(btn)
        assert(btn.get_combined_minimum_size().y >= 48)
        btn.queue_free()
    var field: VBoxContainer = UI.field("auth.login.name",true)
    root.add_child(field)
    assert(field.get_node("Edit") is LineEdit)
    UI.set_field_error(field,"auth.login.error.invalid")
    assert(field.get_node("Error").visible)
    field.queue_free()
    var empty: VBoxContainer = UI.empty_state("◇","ui.empty.title","ui.empty.help","ui.empty.action")
    root.add_child(empty)
    assert(empty.get_node("Action") is Button)
    empty.queue_free()
    var loading: VBoxContainer = UI.loading()
    root.add_child(loading)
    assert(loading.get_node("Retry") is Button)
    loading.queue_free()
    var dialog: ConfirmationDialog = UI.confirm("update.screen.title","update.screen.note.mandatory")
    root.add_child(dialog)
    assert(dialog.dialog_text.length() > 0)
    dialog.queue_free()
    var toast = preload("res://ui/toast.gd").new()
    root.add_child(toast)
    await process_frame
    toast.show_text("ui.empty.title")
    assert(toast.visible and toast.timer.wait_time >= 3.0 and toast.timer.wait_time <= 4.0)
    toast.queue_free()
    var two: Control = Two.new()
    root.add_child(two)
    await process_frame
    two.refresh_size(Vector2(1280,720))
    assert(two.list_area.visible and not two.detail_area.visible)
    two.show_detail()
    assert(two.detail_area.visible and not two.list_area.visible)
    two.refresh_size(Vector2(2000,1200))
    assert(two.list_area.visible and two.detail_area.visible and not two.back_button.visible)
    two.queue_free()
    var shell := MarginContainer.new()
    root.add_child(shell)
    Safe.apply(shell,Vector2(1280,720),Rect2i(100,0,2200,1080),Vector2i(2400,1080))
    assert(shell.get_theme_constant("margin_left") >= 65)
    assert(shell.get_theme_constant("margin_right") >= 65)
    shell.queue_free()
    assert(Forest.scale_for(Vector2(2560,1080)) <= 1.5)
    print("ui1 component smoke OK")
    quit(0)
